# Copy to .env and fill in. Lines starting with # are ignored.

# The address people use from outside, used in e-mail links. e.g. https://fieldbook.ddbuilder.us
PUBLIC_URL=
# Set to true when Fieldbook sits behind Cloudflare Tunnel or another proxy: visits over https
# then get Secure cookies and the real visitor address is used for sign-in limits.
TRUST_PROXY=false
# COOKIE_SECURE=true   # only if EVERY visit is over https (breaks plain http://NAS-IP:8080)

# Website hosted on GitHub Pages (or another site)? List its address here so browsers may use
# this server from it — scheme + host only, comma-separated. Example:
#   ALLOWED_ORIGINS=https://fieldbook.ddbuilder.us
ALLOWED_ORIGINS=

# Can people create their own account on the sign-in page? (An Admin still approves them.)
# false = only Admins create accounts (Fieldbook → your name → Password & sign out → Sign-in accounts)
ALLOW_SIGNUP=true

# ---- AI (optional): receipt reading, project analysis, weekly drafts ----
# Leave everything empty to run without AI (receipts can still be entered by hand).
#
# Option A — fully local, no Internet: an OpenAI-compatible server on your network,
# e.g. Ollama on a PC with a GPU (ollama pull qwen2.5vl:7b) or LM Studio:
# AI_PROVIDER=openai
# AI_BASE_URL=http://192.168.1.20:11434/v1
# AI_MODEL=qwen2.5vl:7b
# AI_API_KEY=                       (only if that server needs one; OpenAI itself: your key + AI_BASE_URL=https://api.openai.com/v1)
#
# Option B — Anthropic's cloud API (https://console.anthropic.com → API keys):
# AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# AI_MODEL=claude-sonnet-4-5
# AI_MODEL_QUICK=claude-haiku-4-5
#
# AI_PER_USER_PER_HOUR=120

# Morning e-mails and account invitations (leave empty to turn off)
#   Gmail:  SMTP_URL=smtps://you%40gmail.com:APP-PASSWORD@smtp.gmail.com:465
#   Other:  SMTP_URL=smtp://user:password@mail.example.com:587
# (In the URL, write @ in the user name as %40.)
SMTP_URL=
MAIL_FROM=
MAIL_FROM_NAME=Fieldbook
# Language of the morning e-mails: en or vi
MAIL_LANG=en

# Job-site weather from Open-Meteo (free, no key). false = off
WEATHER=true

# Daily database backup into data/backups at this hour (server time); how many to keep (0 = off)
BACKUP_HOUR=2
BACKUP_KEEP=14

# Biggest upload in MB (photos, receipts, documents)
MAX_UPLOAD_MB=50

# Cloudflare Tunnel token (only for: docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=

# Time zone for the daily backup hour (Docker only)
TZ=Asia/Ho_Chi_Minh

# Running without Docker:
# PORT=8080
# DATA_DIR=data
